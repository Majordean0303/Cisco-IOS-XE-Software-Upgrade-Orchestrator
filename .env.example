# Device Credentials
# Priority: Windows Credential Manager → Environment Variables → .env file
# For production, use: python orchestrator.py setup-credentials

DEVICE_USERNAME=admin
DEVICE_PASSWORD=your_password_here
DEVICE_ENABLE_PASSWORD=your_enable_password_here

# Jump Host / Bastion Credentials (if using jump host)
JUMP_HOST_USERNAME=jumphost_user
JUMP_HOST_PASSWORD=jumphost_password
